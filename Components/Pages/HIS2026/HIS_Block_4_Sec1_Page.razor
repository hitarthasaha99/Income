    void CheckWarnings()
    {
        try
        {
            //Warning for member count mismatch
            if (hhd != null && hhd.Block_7_5 != block_4?.item_1)
            {
                Block_4_1_ErrorMessage = $"W013(ii): Mismatch between number of listed members and members in Block 3";
